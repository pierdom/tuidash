# Public URL for the web server (used by --serve).
# Set this when auto-detection picks the wrong IP (e.g. inside Docker).
# Example for Docker with host port 8080: TUIDASH_SERVE_URL=http://localhost:8080
TUIDASH_SERVE_URL=

# Use hostname.local (mDNS/Bonjour) as the public URL instead of a raw IP.
# Enable this to reach the dashboard at http://yourhostname.local:8080 on the LAN.
# Requires mDNS to be running (Avahi on Linux, Bonjour on macOS/Windows).
TUIDASH_SERVE_MDNS=false

# Theme (default: textual-dark)
# Available: textual-dark, textual-light, nord, gruvbox, catppuccin-mocha,
#            dracula, tokyo-night, monokai, flexoki, catppuccin-latte,
#            catppuccin-frappe, catppuccin-macchiato, solarized-light,
#            solarized-dark, rose-pine, rose-pine-moon, rose-pine-dawn,
#            atom-one-dark, atom-one-light
TUIDASH_THEME=

# Colour palette (default: default)
# Stem of a .toml file inside the palettes/ folder, or an absolute path to any .toml file.
# Copy palettes/default.toml, adjust the colours, and point this at the new name or path.
TUIDASH_PALETTE=

# Respect terminal transparency (default: false)
# When true, the base canvas (Screen, header, footer, scrollbars) uses the
# terminal's default background instead of the palette's solid colour, so
# terminal transparency / background images show through. Borders, accents and
# bar colours stay truecolor. No effect over HTTP (--serve, browser has its own bg).
TUIDASH_TRANSPARENT=false

# Refresh interval in seconds for data widgets (default: 300)
TUIDASH_REFRESH=300

# Weather (Open-Meteo, no API key required)
# TUIDASH_WEATHER_LOCATION accepts a city name ("Rome") or "lat,lon" ("41.9,12.5")
TUIDASH_WEATHER_LOCATION=
# TUIDASH_WEATHER_UNITS: "metric" (default, °C / km/h) or "imperial" (°F / mph)
TUIDASH_WEATHER_UNITS=metric

# Ghostfolio
TUIDASH_GHOSTFOLIO_URL=
TUIDASH_GHOSTFOLIO_TOKEN=
# Portfolio goal for the progress bar (default: 1000000). Currency is taken from Ghostfolio settings.
TUIDASH_GHOSTFOLIO_GOAL=1000000

# Holiday calendar (ICS URL — any public .ics feed works)
# e.g. https://www.officeholidays.com/ics-clean/spain
TUIDASH_HOLIDAY_CALENDAR=

# Family calendar (ICS URL — highlights family events on the calendar)
TUIDASH_FAMILY_ICS=
# Color for family event days (any Rich color name, e.g. yellow, cyan, magenta)
TUIDASH_FAMILY_COLOR=yellow

# Personal calendar (ICS URL — highlights personal events on the calendar)
TUIDASH_PERSONAL_ICS=
# Color for personal event days (any Rich color name, e.g. cyan, magenta)
TUIDASH_PERSONAL_COLOR=cyan

# Work calendar (ICS URL — highlights work events on the calendar)
TUIDASH_WORK_ICS=
# Color for work event days (any Rich color name, e.g. green, cyan, magenta)
TUIDASH_WORK_COLOR=green

# RSS (comma-separated feed URLs)
TUIDASH_RSS_FEEDS=
# Show article thumbnails in the News page (default: false). Set to true to enable image downloads.
TUIDASH_NEWS_PICTURES=false

# Hosts (comma-separated Glances URLs; name is auto-derived from hostname)
TUIDASH_HOSTS=

# Privacy
# Start in privacy mode (blurs monetary values). Can still be toggled with [p].
TUIDASH_PRIVACY_DEFAULT=false
# Force privacy mode on startup and disable the [p] toggle entirely.
TUIDASH_PRIVACY_FORCE=false

# Connectivity widget
# Comma-separated IPs to ping for reachability (default: 1.1.1.1,8.8.8.8,192.168.1.1)
TUIDASH_REACHABILITY_IPS=
# Comma-separated hostnames to resolve for DNS check (default: google.com,amazon.com,facebook.com)
TUIDASH_RESOLVE_HOSTS=
# DNS resolver IP to use for DNS checks (default: system resolver)
TUIDASH_DNS_RESOLVER=
# Theoretical max download / upload in Mbps for speed bar scaling (default: 600)
TUIDASH_NETSPEED_DOWN=600
TUIDASH_NETSPEED_UP=600
# Speedtest Tracker instance (https://github.com/alexjustesen/speedtest-tracker)
# Speed section is hidden when URL is unset
TUIDASH_SPEEDTESTTRACKER_URL=
TUIDASH_SPEEDTESTTRACKER_TOKEN=

# Relay widget — Markdown content feed
# Base URL of the relay API (required)
TUIDASH_RELAY_URL=
# Bearer token for the relay API (required)
TUIDASH_RELAY_TOKEN=

# Hetzner Cloud (https://docs.hetzner.cloud/)
# API token from https://console.hetzner.cloud/ → project → Security → API Tokens
TUIDASH_HETZNER_KEY=

# Tailscale (https://tailscale.com/api)
# API key from https://login.tailscale.com/admin/settings/keys
TUIDASH_TAILSCALE_KEY=

# Podcasts (PodcastIndex.org — https://api.podcastindex.org/)
# API key and secret from https://api.podcastindex.org/
TUIDASH_PODCASTINDEX_KEY=
TUIDASH_PODCASTINDEX_SECRET=
# Comma-separated PodcastIndex feed IDs to display
# Find feed IDs at https://podcastindex.org/ (shown in the podcast URL)
TUIDASH_PODCASTINDEX_IDS=
